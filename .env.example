# Copy this file to .env, then paste in the key from the projector.
#   copy .env.example .env
# NEVER commit .env - it is listed in .gitignore for a reason.
# Close this file once you have saved it. A key on screen is a key shared.

# The department's key. Your instructor will put it on the projector.
# This one is for the APP. Cline needs the same key typed into its own
# settings panel - that is a separate step, and skipping it is the most
# common way to arrive unable to work.
ZAI_API_KEY=paste-your-key-here
